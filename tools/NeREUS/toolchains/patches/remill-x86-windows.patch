index e61d646..019ac24 100644
--- a/lib/Arch/Arch.cpp
+++ b/lib/Arch/Arch.cpp
@@ -159,6 +159,20 @@ llvm::Triple Arch::BasicTriple(void) const {
 
 auto Arch::GetArchByName(llvm::LLVMContext *context_, OSName os_name_,
                          ArchName arch_name_) -> ArchPtr {
+#ifdef REMILL_X86_ONLY
+  switch (arch_name_) {
+    case kArchX86:
+    case kArchX86_AVX:
+    case kArchX86_AVX512:
+    case kArchAMD64:
+    case kArchAMD64_AVX:
+    case kArchAMD64_AVX512:
+      return GetX86(context_, os_name_, arch_name_);
+    default:
+      LOG(ERROR) << "Architecture unavailable in REMILL_X86_ONLY build";
+      return nullptr;
+  }
+#else
   switch (arch_name_) {
     case kArchInvalid:
       LOG(FATAL) << "Unrecognized architecture.";
@@ -250,6 +264,7 @@ auto Arch::GetArchByName(llvm::LLVMContext *context_, OSName os_name_,
       return nullptr;
     }
   }
+#endif
 }
 
 auto Arch::Build(llvm::LLVMContext *context_, OSName os_name_,
